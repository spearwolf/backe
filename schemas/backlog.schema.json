{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "id_prefix": {
      "type": "string",
      "pattern": "^[a-z]{2,6}$"
    },
    "admins": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!me$)[a-z0-9][a-z0-9-]{1,31}$"
      }
    },
    "workflow": {
      "default": {
        "strict": false
      },
      "type": "object",
      "properties": {
        "strict": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "sync": {
      "default": {
        "mode": "auto",
        "remote": "origin",
        "branch": "main",
        "pull_interval": 60
      },
      "type": "object",
      "properties": {
        "mode": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ]
        },
        "remote": {
          "default": "origin",
          "type": "string",
          "pattern": "^(?!-)[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "branch": {
          "default": "main",
          "type": "string",
          "pattern": "^(?!-)[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "pull_interval": {
          "default": 60,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "verify": {
      "default": "strict",
      "type": "string",
      "enum": [
        "strict",
        "warn",
        "off"
      ]
    },
    "attachments": {
      "default": {
        "max_bytes": 10485760,
        "lfs": false
      },
      "type": "object",
      "properties": {
        "max_bytes": {
          "default": 10485760,
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "lfs": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "props_strict": {
      "default": false,
      "type": "boolean"
    },
    "props": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "enum",
              "json"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ordered": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "name",
    "id_prefix",
    "admins"
  ],
  "additionalProperties": false
}
