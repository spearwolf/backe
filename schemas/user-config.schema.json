{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "current": {
      "type": "string",
      "minLength": 1
    },
    "user": {
      "type": "string"
    },
    "identities": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      }
    },
    "backlogs": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "remote": {
            "type": "string",
            "minLength": 1
          },
          "user": {
            "type": "string"
          },
          "paths": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "sync": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "auto",
                  "manual"
                ]
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "repos": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "text",
            "json",
            "md"
          ]
        },
        "color": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
