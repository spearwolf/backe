{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "current": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "user": {
      "type": "string",
      "pattern": "^(?!me$)[a-z0-9][a-z0-9-]{1,31}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\/[a-z0-9][a-z0-9-]*){0,4}$"
    },
    "sprint": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "identities": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^(?!me$)[a-z0-9][a-z0-9-]{1,31}$"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!~[^/])"
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      }
    },
    "backlogs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "remote": {
            "type": "string",
            "pattern": "^(?!-)[^\\s\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "user": {
            "type": "string",
            "pattern": "^(?!me$)[a-z0-9][a-z0-9-]{1,31}$"
          },
          "project": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(?:\\/[a-z0-9][a-z0-9-]*){0,4}$"
          },
          "sprint": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "paths": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^(?!me$)[a-z0-9][a-z0-9-]{1,31}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!~[^/])"
            }
          },
          "sync": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "auto",
                  "manual"
                ]
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "repos": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!~[^/])"
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "text",
            "json",
            "md"
          ]
        },
        "color": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
