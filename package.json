{
  "name": "@spearwolf/backe",
  "version": "0.4.0",
  "description": "Git-based backlog CLI",
  "author": "Wolfger Schramm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spearwolf/backe.git"
  },
  "homepage": "https://github.com/spearwolf/backe#readme",
  "bugs": {
    "url": "https://github.com/spearwolf/backe/issues"
  },
  "keywords": [
    "backlog",
    "issues",
    "git",
    "cli",
    "mcp",
    "agents"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "backe": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "biome check . && tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p test/browser",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build": "tsdown && vite build --config web/vite.config.ts && node scripts/check-ui-build.ts",
    "dev:ui": "vite --config web/vite.config.ts",
    "prepack": "pnpm run build",
    "gen:schemas": "node scripts/gen-schemas.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "commander": "^15.1.0",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@dagrejs/dagre": "3.1.4",
    "@dnd-kit/core": "6.3.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "@spearwolf/eventize": "^6.3.0",
    "@spearwolf/signalize": "^1.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.28",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@xyflow/react": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-check": "^4.10.2",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "highlight.js": "^11.12.0",
    "jsdom": "^31.0.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.79.0",
    "mermaid": "^12.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
