{
  "name": "@spearwolf/backe",
  "version": "0.1.1",
  "description": "Git-based backlog CLI",
  "author": "Wolfger Schramm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spearwolf/backe.git"
  },
  "homepage": "https://github.com/spearwolf/backe#readme",
  "bugs": {
    "url": "https://github.com/spearwolf/backe/issues"
  },
  "keywords": [
    "backlog",
    "issues",
    "git",
    "cli",
    "mcp",
    "agents"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "backe": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "biome check . && tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "tsdown",
    "prepack": "pnpm run build",
    "gen:schemas": "node scripts/gen-schemas.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "commander": "^15.1.0",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
