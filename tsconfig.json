{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "es2024.string"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "scripts", "*.config.ts"],
  // Die Browser-Specs reichen Funktionen in die Seite und brauchen dafür die DOM-Typen; die soll der
  // Node-Code nie sehen. Sie prüft test/browser/tsconfig.json.
  "exclude": ["test/browser"]
}
