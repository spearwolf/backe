[
  {
    "name": "attachment_add",
    "description": "Add an attachment (like backe attach add); exactly one of path (file in the server working directory, relative to it), url, json, text",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "json": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    }
  },
  {
    "name": "attachment_get",
    "description": "Get an attachment of an issue (like backe attach get); small UTF-8 files are included as text",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    }
  },
  {
    "name": "batch",
    "description": "Several operations in one commit (like backe batch); ops are objects in the format of backe.md §2.16.6, placeholders such as $a link them; supported: issue.create, issue.edit, issue.move, issue.resume, issue.reopen, issue.rank, comment.add, attach.add with url and, with --allow-delete, issue.delete",
    "inputSchema": {
      "type": "object",
      "properties": {
        "ops": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "ops"
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false
    }
  },
  {
    "name": "comment_add",
