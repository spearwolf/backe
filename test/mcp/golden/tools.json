        "has_prop": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "query": {
          "type": "string"
        },
        "tree": {
          "type": "boolean"
        },
        "sort": {
          "type": "string",
          "enum": [
            "rank",
            "created"
          ]
        },
        "all": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
