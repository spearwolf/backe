#!/bin/sh
# Fake-git für src/git/exec.test.ts; liegt nur im PATH, den ein Test ausdrücklich setzt.
case "$1" in
  status)
    # Zeigt das Env, mit dem backe git startet.
    env
    ;;
  hang)
    # Ein Enkelprozess, der die Gruppe teilt; seine PID geht nach stdout und in die FIFO "$2".
    # Danach hält nur noch der Enkel sie offen: Ihr Dateiende sagt dem Test, dass er beendet ist.
    exec 3>"$2"
    sleep 30 &
    echo "$!"
    echo "$!" >&3
    exec 3>&-
    wait
    ;;
  *)
    echo "fake git: unbekannter Aufruf $*" >&2
    exit 2
    ;;
esac
